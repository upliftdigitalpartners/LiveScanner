<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose drives all real theming; this base theme just removes the action bar
         and gives a dark window background so there's no white flash before first draw. -->
    <style name="Theme.LiveScanner" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
